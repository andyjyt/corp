# Copy to .env.local and fill in. See README for where each value comes from.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Used to write the shared places catalog. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Google Maps Platform
# Server key: Places API (New) + Routes API. Restrict by API, not referrer.
GOOGLE_MAPS_API_KEY=
# Browser key: Maps JavaScript API only, restricted to your site's referrers.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Optional: a Map ID from Google Cloud → Map Management (DEMO_MAP_ID is used otherwise).
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
